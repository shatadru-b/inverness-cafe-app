# Public Square Web Payments (safe in the browser)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxx
NEXT_PUBLIC_SQUARE_LOCATION_ID=Lxxxxxxxx
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# Optional: override payment API URL (default: /api/createPayment via Firebase rewrite)
# NEXT_PUBLIC_PAYMENT_API_URL=https://europe-west2-inverness-cafe-app.cloudfunctions.net/createPayment

# ---------------------------------------------------------------------------
# Google Places API key — SERVER ONLY
# Put the real key in functions/.env (gitignored), NEVER here and NEVER as NEXT_PUBLIC_*:
#
#   functions/.env
#   GOOGLE_PLACES_API_KEY=your_secret_key
#   GOOGLE_PLACE_ID=ChIJX6sDqiVxj0gR9MQnrSXXgrk
#
# The browser only calls /api/googleReviews; the key stays on Cloud Functions.
# ---------------------------------------------------------------------------
